{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovware.dev/schema/eval-report.schema.json",
  "title": "Sovware eval report",
  "description": "The result of running an eval set. Must include failures (SPEC R12).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "eval",
    "domain",
    "version",
    "holdout_hash",
    "sealed",
    "cases",
    "passed",
    "failed",
    "ok",
    "created"
  ],
  "properties": {
    "schema": { "const": "sovware.dev/eval-report/v1" },
    "eval": { "type": "string" },
    "domain": { "type": "string" },
    "version": { "type": "string" },
    "holdout_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "sealed": { "type": "boolean" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["set", "program", "expect", "actual", "ok", "run", "failed_verifiers"],
        "properties": {
          "set": { "enum": ["train", "holdout", "known-bad"] },
          "program": { "type": "string" },
          "expect": { "type": "string" },
          "actual": { "type": "string" },
          "ok": { "type": "boolean" },
          "run": { "type": "string", "pattern": "^run_[a-f0-9]{12}$" },
          "failed_verifiers": { "type": "array", "items": { "type": "string" } },
          "must_fail": { "type": "string" },
          "defect": { "type": "string" }
        }
      }
    },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "ok": { "type": "boolean" },
    "created": { "type": "string", "format": "date-time" }
  }
}
